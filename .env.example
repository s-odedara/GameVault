# Django Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Third Party APIs
RAWG_API_KEY=your_rawg_api_key_here

# Marketplace payment gateway — free TEST mode keys from https://dashboard.razorpay.com/app/keys
# (No KYC/business verification needed for Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ---------------------------------------------------------------
# 🔥 SECURITY SETTINGS (sab optional hain, sensible defaults already
# code mein hain — yahan sirf tab override karo agar defaults badalne hain)
# ---------------------------------------------------------------

# Rate limits (format: "number/period", period = sec/min/hour/day)
THROTTLE_RATE_PUBLIC=60/min
THROTTLE_RATE_AUTHENTICATED=300/min
THROTTLE_RATE_AUTH=20/min
THROTTLE_RATE_PAYMENT=30/min

# Login/Register exponential backoff (seconds)
AUTH_THROTTLE_BASE_SECONDS=1
AUTH_THROTTLE_MAX_SECONDS=900
AUTH_THROTTLE_WINDOW_SECONDS=3600
AUTH_THROTTLE_MAX_TRACKED_ATTEMPTS=10

# File upload size limit (MB)
MAX_UPLOAD_SIZE_MB=5

# Production mein multiple gunicorn workers ke saath rate-limiting sahi se
# kaam kare, iske liye Redis chalao aur yahan uska URL daalo (optional —
# empty chhodne par in-memory cache use hoga, jo single-worker local dev
# ke liye theek hai)
REDIS_URL=

# ---------------------------------------------------------------
# PRODUCTION EXAMPLE (deploy karte waqt in values ko badal dena):
# DEBUG=False
# SECRET_KEY=<django-admin shell se naya random secret generate karo>
# ALLOWED_HOSTS=gamevault-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
# DATABASE_URL=postgres://user:password@host:5432/dbname   (optional, Postgres ke liye)
# REDIS_URL=redis://your-redis-host:6379/0                 (recommended for production)
# ---------------------------------------------------------------
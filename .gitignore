# ============================================================

# --- Secrets: KABHI commit mat karna ---
.env
.env.local
.env.production
*.pem
*.key

# --- Backend (Django/Python) ---
env/
venv/
__pycache__/
*.pyc
*.pyo
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
*.log

# --- Frontend (React/Vite) ---
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# --- Editor / OS junk ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vite requires custom env variables to be prefixed with VITE_
#
# 🔥 SECURITY: RAWG_API_KEY yahan NAHI hoti — koi bhi VITE_ variable
# browser bundle mein bake ho jaata hai aur public ho jaata hai. RAWG key
# sirf backend ke .env mein rehti hai (backend proxy /api/rawg/... use hota hai).

# Apna deployed Django backend ka URL yahan daalo (local dev me localhost hi rehne do)
# Production example: VITE_API_URL=https://gamevault-backend.onrender.com/api
VITE_API_URL=http://127.0.0.1:8000/api
